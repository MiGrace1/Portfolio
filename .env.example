# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Public URL of the site, without trailing slash.
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Phase 6). Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# GEP live link. Server-only. Leave empty until written authorization,
# then also enable confidentiality.showLiveLink in src/lib/site-config.ts.
GEP_LIVE_URL=
